{
  "name": "project-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Project RELAY \u2014 The Autonomous Dispatch Desk",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @relay/api",
    "dev:web": "npm run dev --workspace @relay/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace @relay/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "seed": "npm run seed --workspace @relay/api"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
